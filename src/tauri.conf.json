{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTMusic",
  "version": "../package.json",
  "identifier": "com.github.udaanilo.ytmusic",
  "build": {
    "beforeDevCommand": "yarn build:web",
    "beforeBuildCommand": "yarn build:web",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ]
  }
}
