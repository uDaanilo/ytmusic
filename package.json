{
  "name": "ytmusic",
  "version": "3.0.0",
  "description": "A youtube music app",
  "author": "uDaanilo",
  "license": "MIT",
  "repository": "github:uDaanilo/ytmusic",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:web": "esbuild web/index.ts --bundle --format=iife --target=chrome110 --loader:.css=text --loader:.html=text --outfile=dist-web/inject.js",
    "typecheck:web": "tsc -p web",
    "sidecars": "node scripts/fetch-sidecars.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2.12.2",
    "@types/trusted-types": "^2.0.7",
    "esbuild": "^0.28.2",
    "typescript": "^4.4.3"
  }
}